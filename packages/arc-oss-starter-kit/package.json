{
  "name": "@arc-oss/starter-kit",
  "version": "1.0.0",
  "description": "React/Next + wagmi/viem starter kit for Arc OSS implementing client-side x402 and session keys on top of Arc primitives",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
